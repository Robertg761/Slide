<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for Android 11 and below.

  The learned words and learned pairs are excluded. Between them they are a list of the words this
  person uses that most people do not — names, places, jargon, the odd medical term — and of the
  phrases they habitually write. Learned touch calibration and salted gesture preferences are
  private behavioural data, and the calibration is device-specific, so both stay behind too. The
  legacy settings DataStore is excluded
  because releases before 0.2.1 kept recent emoji usage inside it. Current non-sensitive settings
  live in keyboard_settings.preferences_pb and are intentionally eligible for backup.

  The update staging directory is excluded for a plainer reason: a staged APK is a few hundred
  megabytes of a file the user can re-download in a minute, and backing it up would blow the whole
  25 MB Auto Backup quota on it, taking the settings that actually matter down with it.
-->
<full-backup-content>
    <exclude domain="file" path="learned_words.txt" />
    <exclude domain="file" path="learned_words.txt.tmp" />
    <exclude domain="file" path="learned_pairs.txt" />
    <exclude domain="file" path="learned_pairs.txt.tmp" />
    <exclude domain="file" path="learned_touch_offsets.txt" />
    <exclude domain="file" path="learned_touch_offsets.txt.tmp" />
    <exclude domain="file" path="learned_gesture_adaptation.txt" />
    <exclude domain="file" path="learned_gesture_adaptation.txt.tmp" />
    <exclude domain="file" path="datastore/slide_settings.preferences_pb" />
    <exclude domain="file" path="datastore/slide_settings.preferences_pb.tmp" />
    <exclude domain="file" path="updates/" />
</full-backup-content>
